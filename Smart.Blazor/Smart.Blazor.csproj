<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <RootNamespace>Smart</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Usa.Smart.Blazor</PackageId>
    <Title>Smart.Blazor</Title>
    <Description>Smart Blazor library</Description>
    <PackageTags>smart aspnetcore blazor</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
  </ItemGroup>

</Project>
