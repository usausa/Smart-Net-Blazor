@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<dialog @ref="element" @attributes="AdditionalAttributes">@ChildContent</dialog>

@code {
    private const string ModulePath = "./_content/Usa.Smart.Blazor/native-dialog.js";

    private ElementReference element;

    private ScriptModule? module;

    private DotNetObjectReference<NativeDialog>? reference;

    private IJSObjectReference? dialog;

    private (bool CloseOnEscape, bool CloseOnBackdropClick) attached;

    private bool shown;

    private bool disposed;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool Modal { get; set; } = true;

    [Parameter]
    public bool CloseOnEscape { get; set; } = true;

    [Parameter]
    public bool CloseOnBackdropClick { get; set; }

    [Parameter]
    public EventCallback<string> OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = new ScriptModule(JSRuntime, ModulePath);
            reference = DotNetObjectReference.Create(this);
            attached = (CloseOnEscape, CloseOnBackdropClick);

            IJSObjectReference created;
            try
            {
                created = await module.InvokeAsync<IJSObjectReference>("attach", element, reference, attached.CloseOnEscape, attached.CloseOnBackdropClick).ConfigureAwait(true);
            }
            catch (ObjectDisposedException) when (disposed)
            {
                return;
            }

            if (disposed)
            {
                await created.ReleaseAsync("dispose").ConfigureAwait(true);
                return;
            }

            dialog = created;
        }

        if ((dialog is null) || disposed)
        {
            return;
        }

        if (attached != (CloseOnEscape, CloseOnBackdropClick))
        {
            attached = (CloseOnEscape, CloseOnBackdropClick);
            await dialog.InvokeVoidAsync("update", attached.CloseOnEscape, attached.CloseOnBackdropClick).ConfigureAwait(true);
        }

        if (Open && !shown)
        {
            shown = true;
            await dialog.InvokeVoidAsync("show", Modal).ConfigureAwait(true);
        }
        else if (!Open && shown)
        {
            shown = false;
            await dialog.InvokeVoidAsync("close").ConfigureAwait(true);
        }
    }

    [JSInvokable]
    public async Task NotifyClose(string returnValue)
    {
        shown = false;
        if (disposed)
        {
            return;
        }

        if (Open)
        {
            await OpenChanged.InvokeAsync(false).ConfigureAwait(true);
        }

        await OnClose.InvokeAsync(returnValue).ConfigureAwait(true);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;

        if (dialog is not null)
        {
            await dialog.ReleaseAsync("dispose").ConfigureAwait(true);
            dialog = null;
        }

        reference?.Dispose();

        if (module is not null)
        {
            await module.DisposeAsync().ConfigureAwait(true);
        }
    }
}
